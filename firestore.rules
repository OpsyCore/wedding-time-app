rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function weddingDoc(weddingId) {
      return get(/databases/$(database)/documents/weddings/$(weddingId)).data;
    }

    function isWeddingMember(weddingId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/weddings/$(weddingId))
        && (
          (weddingDoc(weddingId).keys().hasAny(['brideUid'])
            && weddingDoc(weddingId).brideUid == uid())
          || (weddingDoc(weddingId).keys().hasAny(['groomUid'])
            && weddingDoc(weddingId).groomUid == uid())
        );
    }

    function isWeddingMemberAfter(weddingId) {
      let afterDoc = getAfter(/databases/$(database)/documents/weddings/$(weddingId)).data;
      return isSignedIn()
        && afterDoc != null
        && (
          (afterDoc.keys().hasAny(['brideUid']) && afterDoc.brideUid == uid())
          || (afterDoc.keys().hasAny(['groomUid']) && afterDoc.groomUid == uid())
        );
    }

    // ⚠️ این لیست باید دقیقاً با AppConfig.adminEmails در
    // lib/core/app_config.dart یکی باشد. بعد از تغییر،
    // با `firebase deploy --only firestore:rules` منتشر کنید.
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'mishe.nemishetube4@gmail.com',
          'abrt1369@gmail.com'
        ];
    }

    // بررسی کد دعوت معتبر هنگام پیوستن همسر دوم (از روی inviteCode نوشته‌شده در سند خصوصی users/{uid})
    function hasValidInviteCodeForJoin(weddingId) {
      let userAfter = getAfter(/databases/$(database)/documents/users/$(uid())).data;
      let code = (userAfter != null && 'inviteCode' in userAfter && userAfter.inviteCode is string)
        ? userAfter.inviteCode
        : '';
      return code.size() > 0
        && exists(/databases/$(database)/documents/invite_codes/$(code))
        && get(/databases/$(database)/documents/invite_codes/$(code)).data.weddingId == weddingId;
    }

    function isJoinBrideUpdate(weddingId) {
      let before = resource.data;
      let after = request.resource.data;
      return isSignedIn()
        && hasValidInviteCodeForJoin(weddingId)
        && after.keys().hasAny(['brideUid'])
        && after.brideUid == uid()
        && (
          !before.keys().hasAny(['brideUid'])
          || before.brideUid == null
          || before.brideUid == ''
        )
        && after.diff(before).affectedKeys().hasOnly(['brideUid', 'updatedAt']);
    }

    function isJoinGroomUpdate(weddingId) {
      let before = resource.data;
      let after = request.resource.data;
      return isSignedIn()
        && hasValidInviteCodeForJoin(weddingId)
        && after.keys().hasAny(['groomUid'])
        && after.groomUid == uid()
        && (
          !before.keys().hasAny(['groomUid'])
          || before.groomUid == null
          || before.groomUid == ''
        )
        && after.diff(before).affectedKeys().hasOnly(['groomUid', 'updatedAt']);
    }

    // FIX-02: کد پیوستن (inviteCode) دیگر روی سند عمومی مراسم ذخیره نمی‌شود؛
    // فقط در invite_codes/{code} و سند خصوصی users/{uid}.
    function isValidWeddingCreate() {
      let d = request.resource.data;
      let hasBride = d.keys().hasAny(['brideUid']) && d.brideUid == uid();
      let hasGroom = d.keys().hasAny(['groomUid']) && d.groomUid == uid();
      return isSignedIn()
        && d.keys().hasAll(['brideName', 'groomName', 'weddingDate'])
        && d.brideName is string
        && d.groomName is string
        && (
          (hasBride && !d.keys().hasAny(['groomUid']))
          || (hasGroom && !d.keys().hasAny(['brideUid']))
          || (hasBride && hasGroom && d.brideUid == d.groomUid)
        );
    }

    function isValidRsvpCreate() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'status', 'source', 'createdAt'])
        && d.name is string
        && d.name.size() > 0
        && d.name.size() <= 80
        && d.status in ['yes', 'no', 'maybe']
        && d.source == 'public_invite'
        && (!('phone' in d) || (d.phone is string && d.phone.size() <= 30))
        && (!('guestId' in d) || d.guestId is string);
    }

    function isValidPublicGuestWrite() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'status', 'rsvpSource'])
        && d.name is string
        && d.name.size() > 0
        && d.name.size() <= 80
        && d.status in ['confirmed', 'declined', 'pending']
        && d.rsvpSource == 'public_invite'
        && (!('phone' in d) || (d.phone is string && d.phone.size() <= 30))
        && (!('group' in d) || d.group is string)
        && (!('note' in d) || (d.note is string && d.note.size() <= 200));
    }

    function isValidPublicRsvpNotification() {
      let d = request.resource.data;
      return d.keys().hasAll(['type', 'title', 'body', 'read', 'createdAt'])
        && d.type == 'rsvp'
        && d.read == false
        && d.title is string
        && d.title.size() > 0
        && d.title.size() <= 120
        && d.body is string
        && d.body.size() > 0
        && d.body.size() <= 300
        && (!('relatedId' in d) || d.relatedId is string);
    }

    function isValidPlanReviewCreate() {
      let d = request.resource.data;
      return isSignedIn()
        && d.keys().hasAll(['name', 'rating', 'comment', 'approved', 'createdAt'])
        && d.name is string
        && d.name.size() > 0
        && d.name.size() <= 80
        && d.comment is string
        && d.comment.size() > 0
        && d.comment.size() <= 1000
        && d.rating is number
        && d.rating >= 1
        && d.rating <= 5
        && d.approved == false
        && (!('planId' in d) || d.planId is string)
        && (!('uid' in d) || d.uid == uid());
    }

    // پشتیبانی — claim با یا بدون لاگین (نام اجباری)
    // فقط زمانی که setting های مهمان روشن باشد (guestClaimEnabled).
    function isValidSupportClaim(weddingId) {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'open'
        && after.status == 'claimed'
        && (
          !exists(/databases/$(database)/documents/weddings/$(weddingId)/supportSettings/main)
          || get(/databases/$(database)/documents/weddings/$(weddingId)/supportSettings/main).data.guestClaimEnabled != false
        )
        && after.claimedByName is string
        && after.claimedByName.size() > 0
        && after.claimedByName.size() <= 80
        && after.diff(before).affectedKeys().hasOnly([
          'status',
          'claimedByName',
          'claimedByUid',
          'claimedByPhone',
          'claimedNote',
          'claimedAt',
          'updatedAt'
        ]);
    }

    // بازخورد زیر مراسم — مهمان بدون لاگین می‌تواند ثبت کند.
    function isValidFeedbackCreate() {
      let d = request.resource.data;
      return d.keys().hasAll(['type', 'message', 'status', 'createdAt'])
        && d.type in ['feedback', 'bug']
        && d.message is string
        && d.message.size() > 0
        && d.message.size() <= 2000
        && d.status == 'new'
        && (!('uid' in d) || d.uid == null || d.uid is string)
        && (!('email' in d) || d.email == null || d.email is string);
    }

    // آپلود عکس مهمان بدون لاگین (ImgBB URL) — همیشه pending مگر زوج
    function isValidPublicGuestMediaCreate() {
      let d = request.resource.data;
      return d.keys().hasAll(['url', 'type', 'status', 'uploaderName', 'createdAt'])
        && d.url is string
        && d.url.size() > 8
        && d.url.size() <= 2000
        && d.url.matches('https://.*')
        && d.type in ['photo', 'video']
        && d.status == 'pending'
        && d.uploaderName is string
        && d.uploaderName.size() > 0
        && d.uploaderName.size() <= 80
        && (!('uploaderKey' in d) || (d.uploaderKey is string && d.uploaderKey.size() <= 120))
        && (!('uploaderUid' in d) || d.uploaderUid == null || d.uploaderUid == '');
    }

    function isValidSignedInGuestMediaCreate() {
      let d = request.resource.data;
      return isSignedIn()
        && d.keys().hasAll(['url', 'type', 'status', 'uploaderName', 'createdAt'])
        && d.url is string
        && d.url.size() > 0
        && d.url.size() <= 2000
        && d.type in ['photo', 'video']
        && d.status in ['pending', 'approved']
        && d.uploaderName is string
        && d.uploaderName.size() > 0
        && d.uploaderName.size() <= 80
        && (!('uploaderUid' in d) || d.uploaderUid == uid())
        && (!('uploaderKey' in d) || d.uploaderKey is string);
    }

    function isValidPublicWishCreate() {
      let d = request.resource.data;
      return d.keys().hasAll(['name', 'message', 'createdAt'])
        && d.name is string
        && d.name.size() > 0
        && d.name.size() <= 80
        && d.message is string
        && d.message.size() > 0
        && d.message.size() <= 1000
        && (!('status' in d) || d.status == 'pending');
    }

    // ─── Plans ───
    match /app_config/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /plan_reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidPlanReviewCreate() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ─── Users ───
    // کاربر عادی فقط می‌تواند پلن free/trial برای خودش ثبت کند، نمی‌تواند بدون تأیید ادمین
    // پلن خودش را به pro/premium ارتقا دهد و نمی‌تواند trialEndsAt را بیش از ۳۱ روز جلو ببرد یا تغییر دهد.
    function isValidTrialWindow(data, existing) {
      let hasPrior = existing != null && 'trialEndsAt' in existing && existing.trialEndsAt != null;
      return !('trialEndsAt' in data)
        || (hasPrior && data.trialEndsAt == existing.trialEndsAt)
        || (!hasPrior
            && data.trialEndsAt is timestamp
            && data.trialEndsAt <= request.time + duration.value(31, 'd'));
    }

    function isSafeUserPlanWrite(data, existing) {
      let allowedSelfPlans = ['free', 'trial'];
      let prevPlanId = (existing != null && 'planId' in existing) ? existing.planId : '';
      let prevPlan = (existing != null && 'plan' in existing) ? existing.plan : '';
      let okPlanId = !('planId' in data)
        || data.planId in allowedSelfPlans
        || data.planId == prevPlanId;
      let okPlan = !('plan' in data)
        || data.plan in allowedSelfPlans
        || data.plan == prevPlan;
      return okPlanId && okPlan && isValidTrialWindow(data, existing);
    }

    match /users/{userId} {
      allow read: if (isSignedIn() && uid() == userId) || isAdmin();
      allow create: if (isSignedIn() && uid() == userId && isSafeUserPlanWrite(request.resource.data, null))
        || isAdmin();
      // ادمین برای فعال‌سازی پلن، planId کاربر را می‌نویسد
      allow update: if isAdmin()
        || (isSignedIn() && uid() == userId && isSafeUserPlanWrite(request.resource.data, resource.data));
      allow delete: if (isSignedIn() && uid() == userId) || isAdmin();
    }

    // ─── تیکت‌های پشتیبانی → ایمیل abrt1369@gmail.com ───
    match /support_tickets/{ticketId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == uid()
        && request.resource.data.keys().hasAll(['uid', 'subject', 'status', 'messages', 'createdAt'])
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 120;
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.uid == uid());
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.uid == uid());
      allow delete: if isAdmin();
    }

    // inbox پشتیبانی مرکزی — آینه برای abrt1369@gmail.com (Trigger → Email)
    match /support_inbox/{docId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ─── درخواست‌های فعال‌سازی پلن ───
    match /plan_requests/{reqId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == uid();
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.uid == uid());
      allow update, delete: if isAdmin();
    }

    match /invite_codes/{code} {
      allow get: if true;
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['weddingId', 'inviteCode'])
        && request.resource.data.weddingId is string
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode == code
        && (
          isWeddingMember(request.resource.data.weddingId)
          || isWeddingMemberAfter(request.resource.data.weddingId)
        );

      allow update, delete: if isSignedIn()
        && resource.data.keys().hasAny(['weddingId'])
        && isWeddingMember(resource.data.weddingId);
    }

    match /public_slugs/{slug} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['weddingId'])
        && request.resource.data.weddingId is string
        && isWeddingMember(request.resource.data.weddingId);

      allow update: if isSignedIn()
        && resource.data.keys().hasAny(['weddingId'])
        && isWeddingMember(resource.data.weddingId)
        && request.resource.data.keys().hasAll(['weddingId'])
        && request.resource.data.weddingId is string
        && isWeddingMember(request.resource.data.weddingId);

      allow delete: if isSignedIn()
        && resource.data.keys().hasAny(['weddingId'])
        && isWeddingMember(resource.data.weddingId);
    }

    // ─── Weddings ───
    function isSafeWeddingPlanWrite(data, existing) {
      let allowedSelfPlans = ['free', 'trial'];
      let prevPlanId = (existing != null && 'planId' in existing) ? existing.planId : '';
      let userPlanId = exists(/databases/$(database)/documents/users/$(uid()))
        ? get(/databases/$(database)/documents/users/$(uid())).data.planId
        : '';
      let okPlanId = !('planId' in data)
        || data.planId in allowedSelfPlans
        || data.planId == prevPlanId
        || data.planId == userPlanId;
      return okPlanId && isValidTrialWindow(data, existing);
    }

    match /weddings/{weddingId} {
      // مهمان بدون لاگین هم spec را get کند (دوربین/خانه)
      // توجه: سند مراسم دیگر شامل inviteCode نیست (FIX-02)
      allow get: if true;
      allow list: if isWeddingMember(weddingId);
      allow create: if isValidWeddingCreate()
        && (isAdmin() || isSafeWeddingPlanWrite(request.resource.data, null));
      // ادمین برای mirror کردن planId روی سند مراسم هم دسترسی دارد
      allow update: if isAdmin()
        || (isWeddingMember(weddingId) && isSafeWeddingPlanWrite(request.resource.data, resource.data))
        || isJoinBrideUpdate(weddingId)
        || isJoinGroomUpdate(weddingId);
      allow delete: if isAdmin() || isWeddingMember(weddingId);

      match /invitation/{docId} {
        allow read: if true;
        allow write: if isWeddingMember(weddingId);
      }

      match /rsvps/{docId} {
        allow read: if isWeddingMember(weddingId);
        allow create: if isValidRsvpCreate();
        allow update, delete: if isWeddingMember(weddingId);
      }

      match /guests/{docId} {
        allow read: if isWeddingMember(weddingId);
        allow create: if isWeddingMember(weddingId) || isValidPublicGuestWrite();
        allow update: if isWeddingMember(weddingId)
          || (
            isValidPublicGuestWrite()
            && (
              (
                'phone' in resource.data
                && resource.data.phone is string
                && resource.data.phone.size() > 0
                && 'phone' in request.resource.data
                && request.resource.data.phone == resource.data.phone
              )
              || (
                'rsvpSource' in resource.data
                && resource.data.rsvpSource == 'public_invite'
              )
            )
          );
        allow delete: if isWeddingMember(weddingId);
      }

      // نوت‌بوک زوج — یادداشت‌های سریع و مهم مراسم
      match /notes/{docId} {
        allow read, write: if isWeddingMember(weddingId);
      }

      match /notifications/{docId} {
        allow read: if isWeddingMember(weddingId);
        allow create: if isWeddingMember(weddingId) || isValidPublicRsvpNotification();
        allow update, delete: if isWeddingMember(weddingId);
      }

      match /supports/{docId} {
        allow read: if true;
        allow create, delete: if isWeddingMember(weddingId);
        allow update: if isWeddingMember(weddingId)
          || isValidSupportClaim(weddingId);
      }

      match /supportSettings/{docId} {
        allow read: if true;
        allow write: if isWeddingMember(weddingId);
      }

      match /supportContribs/{docId} {
        allow read: if isWeddingMember(weddingId);
        allow create: if isWeddingMember(weddingId)
          || (
            !exists(/databases/$(database)/documents/weddings/$(weddingId)/supportSettings/main)
            || get(/databases/$(database)/documents/weddings/$(weddingId)/supportSettings/main).data.guestClaimEnabled != false
          );
        allow update, delete: if isWeddingMember(weddingId);
      }

      match /checklist/{docId} {
        allow read, write: if isWeddingMember(weddingId);
      }

      match /budgetGroups/{groupId} {
        allow read, write: if isWeddingMember(weddingId);
        match /expenses/{expenseId} {
          allow read, write: if isWeddingMember(weddingId);
        }
      }

      match /vendors/{docId} {
        allow read, write: if isWeddingMember(weddingId);
      }

      match /vendorPayments/{docId} {
        allow read, write: if isWeddingMember(weddingId);
      }

      match /calendarEvents/{docId} {
        allow read: if true;
        allow write: if isWeddingMember(weddingId);
      }

      // تایم‌لاین عمومی فقط‌خواندنی
      match /timeline/{docId} {
        allow read: if true;
        allow write: if isWeddingMember(weddingId);
      }

      // گالری / دوربین مهمان
      match /guestMedia/{docId} {
        allow read: if isWeddingMember(weddingId)
          || resource.data.status == 'approved'
          || (isSignedIn()
              && resource.data.keys().hasAny(['uploaderUid'])
              && resource.data.uploaderUid == uid());

        allow create: if isWeddingMember(weddingId)
          || isValidSignedInGuestMediaCreate()
          || isValidPublicGuestMediaCreate();

        allow update, delete: if isWeddingMember(weddingId);
      }

      match /galleryPhotos/{docId} {
        allow read: if true;
        allow write: if isWeddingMember(weddingId);
      }

      match /gallery/{docId} {
        allow read: if true;
        allow write: if isWeddingMember(weddingId);
      }

      // FIX-06: تنظیمات دوربین فقط توسط زوج نوشته شود (قبلاً عمومی بود)
      match /cameraSettings/{docId} {
        allow read: if true;
        allow write: if isWeddingMember(weddingId);
      }

      // ماژول‌های سرگرمی مهمان‌ها — شل مهمان بدون لاگین می‌خواند
      match /entertainmentSettings/{docId} {
        allow read: if true;
        allow write: if isWeddingMember(weddingId);
      }

      match /cameraUsage/{docId} {
        allow read: if isWeddingMember(weddingId);
        allow create, update: if isWeddingMember(weddingId)
          || (
            request.resource.data.keys().size() <= 4
            && (!('count' in request.resource.data)
                || (request.resource.data.count is int
                    && request.resource.data.count >= 0
                    && request.resource.data.count <= 500))
          );
        allow delete: if isWeddingMember(weddingId);
      }

      // FIX-07: آرزوها
      // - خواندن عمومی فقط برای آرزوهای approved (در انتظار/ردشده محرمانه است)
      // - ایجاد: یا شکل عمومی معتبر (بدون لاگین) یا خود زوج
      match /wishes/{docId} {
        allow read: if isWeddingMember(weddingId)
          || resource.data.status == 'approved';
        allow create: if isValidPublicWishCreate() || isWeddingMember(weddingId);
        allow update, delete: if isWeddingMember(weddingId);
      }

      match /bridalParty/{docId} {
        allow read: if true;
        allow write: if isWeddingMember(weddingId);
      }

      match /seating/{docId} {
        allow read: if true;
        allow write: if isWeddingMember(weddingId);
      }

      match /seats/{docId} {
        allow read: if true;
        allow write: if isWeddingMember(weddingId);
      }

      match /tables/{docId} {
        allow read: if true;
        allow write: if isWeddingMember(weddingId);
      }

      match /halls/{docId} {
        allow read: if true;
        allow write: if isWeddingMember(weddingId);
      }

      match /musicSettings/{docId} {
        allow read: if true;
        allow write: if isWeddingMember(weddingId);
      }

      match /gifts/{giftId} {
        // مهمان فقط‌خواندنی (مطابق هنداف) — رزرو/لغو توسط مهمان حذف شد.
        allow read: if true;
        allow create, delete: if isWeddingMember(weddingId);
        allow update: if isWeddingMember(weddingId);
      }

      // لاگ هدیه‌های دریافت‌شده — فقط توسط زوج مدیریت می‌شود.
      match /receivedGifts/{docId} {
        allow read, write: if isWeddingMember(weddingId);
      }

      // بازخورد زیر مراسم
      match /feedback/{docId} {
        allow read: if isWeddingMember(weddingId);
        allow create: if isValidFeedbackCreate();
        allow update, delete: if isWeddingMember(weddingId);
      }

      match /giftSettings/{docId} {
        allow read: if true;
        allow write: if isWeddingMember(weddingId);
      }

      match /loveStory/{docId} {
        allow read: if true;
        allow write: if isWeddingMember(weddingId);
      }

      match /loveStories/{docId} {
        allow read: if true;
        allow write: if isWeddingMember(weddingId);
      }

      // بقیه فقط عضو زوج
      match /{sub=**} {
        allow read, write: if isWeddingMember(weddingId);
      }
    }
  }
}
